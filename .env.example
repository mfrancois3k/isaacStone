# XAI_API_KEY: Server-side key for Wamy, the site's chat agent (xAI / Grok).
# Set it in the Vercel project's environment variables, never in this repo.
# Without it the agent serves scripted replies that quote no prices.
XAI_API_KEY="MY_XAI_API_KEY"
# Saved xAI voice agent. Used server-side to connect browser voice sessions.
XAI_AGENT_ID="agent_VhLSbCED78dh7q3o"
# XAI_MODEL: Optional override. Defaults to grok-4.6.
XAI_MODEL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LEADS_TOKEN: Shared secret guarding GET /api/leads, which returns customers'
# names and phone numbers. Leave unset and the route is disabled (404).
# Send it as the x-leads-token header.
LEADS_TOKEN="MY_LEADS_TOKEN"

# Lead MVP: configure either LEAD_WEBHOOK_URL (the durable lead list) OR the
# Resend owner inbox variables below. Configure both for a durable list plus
# instant alerts. Never put these values in frontend code.
# LEAD_WEBHOOK_URL accepts a JSON POST (n8n, Zapier, Make, Pipedream, etc.).
LEAD_WEBHOOK_URL="MY_LEAD_WEBHOOK_URL"

# Resend: owner gets the complete request; a customer who provides an email
# gets a simple confirmation. RESEND_FROM_EMAIL must be a verified sender.
RESEND_API_KEY="re_xxxxxxxxx"
RESEND_FROM_EMAIL="Isaac Stone and Tile <leads@example.com>"
OWNER_EMAIL="owner@example.com"

# Twilio: the owner gets an optional new-lead SMS. The visitor gets an SMS
# confirmation only when they explicitly tick the consent checkbox in the UI.
TWILIO_ACCOUNT_SID="ACxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxx"
TWILIO_FROM_NUMBER="+16315551234"
TWILIO_OWNER_TO_NUMBER="+16315551234"
